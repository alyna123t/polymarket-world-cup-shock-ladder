{
  "emoji": "🏆",
  "primaryEnv": "SIMMER_API_KEY",
  "requires": {
    "env": [
      "SIMMER_API_KEY"
    ],
    "pip": [
      "simmer-sdk>=0.17.1"
    ]
  },
  "envVars": [
    {
      "name": "SIMMER_API_KEY",
      "required": true,
      "description": "Simmer SDK API key"
    }
  ],
  "cron": null,
  "autostart": false,
  "automaton": {
    "managed": true,
    "entrypoint": "world_cup_shock_ladder.py"
  },
  "tunables": [
    {
      "env": "SIMMER_WC_SHOCK_DROP_PCT",
      "type": "number",
      "default": 0.15,
      "range": [0.05, 0.4],
      "step": 0.01,
      "label": "Shock percentage threshold"
    },
    {
      "env": "SIMMER_WC_SHOCK_DROP_ABS",
      "type": "number",
      "default": 0.08,
      "range": [0.02, 0.3],
      "step": 0.01,
      "label": "Shock absolute drop"
    },
    {
      "env": "SIMMER_WC_MAX_POSITION_USD",
      "type": "number",
      "default": 20,
      "range": [2, 200],
      "step": 2,
      "label": "Max position per shock"
    },
    {
      "env": "SIMMER_WC_DAILY_BUDGET_USD",
      "type": "number",
      "default": 60,
      "range": [10, 1000],
      "step": 10,
      "label": "Daily budget"
    },
    {
      "env": "SIMMER_WC_MAX_TRADES_PER_RUN",
      "type": "number",
      "default": 4,
      "range": [1, 20],
      "step": 1,
      "label": "Max trades per run"
    }
  ]
}
